{
  // Baseline ACL for a single organization. Install it and point the unit's
  // -policy flag at the copy under /etc/xunara, then reload:
  //   systemctl restart xunarad
  //
  // Without a policy the tailnet runs allow-all, which the security page in
  // the console reports as a high-severity finding.

  // Owners of a tag may hand it out with a pre-auth key of that tag.
  "tagOwners": {
    "tag:server": ["local"],
    "tag:ci": ["local"],
  },

  // Who may reach whom. Replace the catch-all with real rules once the
  // tailnet has more than one trust boundary.
  "acls": [
    { "action": "accept", "src": ["*"], "dst": ["*:*"] },
  ],

  // Tailscale SSH checks: an empty list keeps the feature off.
  "ssh": [],
}
