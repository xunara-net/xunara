# Xunara control plane environment (install to /etc/xunara/xunarad.env, mode 0600).
#
# Every value here is read by xunarad's *-env flags, so secrets stay out of
# `ps` output and out of the unit file. Uncomment only what you configure, and
# restart the service after editing: systemctl restart xunarad
#
# OIDC client secret for the identity provider configured with -oidc-issuer
# and -oidc-client-id. Add the OIDC flags to the unit when you use it.
#XUNARA_OIDC_CLIENT_SECRET=
#
# Bearer token for /api/platform and the platform gRPC service. Without it the
# platform API is disabled (fail closed); with it, keep the port private.
#XUNARA_PLATFORM_ADMIN_TOKEN=
#
# HMAC secret for audit webhook delivery (-webhook-url).
#XUNARA_WEBHOOK_SECRET=
#
# Bearer token for the DNS webhook that answers ACME DNS-01 challenges.
#XUNARA_DNS_WEBHOOK_TOKEN=
#
# Cloudflare API token when using -dns-cloudflare-zone for ACME DNS-01.
#XUNARA_CLOUDFLARE_API_TOKEN=
