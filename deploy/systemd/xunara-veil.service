[Unit]
Description=Xunara Veil (DERP relay)
Documentation=https://github.com/xunara-net/xunara
After=network-online.target
Wants=network-online.target
# The relay admits node keys through the control plane's /derp/admit, so it
# starts after the control plane is up. A control plane that is down makes the
# relay fail closed (it refuses clients) rather than admit strangers.
After=xunarad.service
Wants=xunarad.service

[Service]
Type=simple
User=xunara
Group=xunara
WorkingDirectory=/var/lib/xunara-veil

EnvironmentFile=-/etc/xunara/xunarad.env

StateDirectory=xunara-veil
StateDirectoryMode=0700
ExecStart=/opt/xunara/bin/xunara-veil \
    -listen 0.0.0.0:@XUNARA_DERP_PORT@ \
    -hostname @XUNARA_DERP_HOST@ \
    -state-dir /var/lib/xunara-veil \
    -cert-mode selfsigned \
    -cert-dir /var/lib/xunara-veil/certs \
    -verify-url http://@XUNARA_CONTROL_ADDR@/derp/admit \
    -derp-map-out /var/lib/xunara-veil/derp.json \
    @XUNARA_STUN_ARGS@ \
    -log-level info

Restart=on-failure
RestartSec=2s

# The relay owns one directory and no other part of the host.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
