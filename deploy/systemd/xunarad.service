[Unit]
Description=Xunara control plane (xunarad)
Documentation=https://github.com/xunara-net/xunara
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xunara
Group=xunara
WorkingDirectory=/var/lib/xunara

# Secrets belong here, mode 0600: OIDC client secret, platform admin token,
# webhook signing secret, DNS webhook token. They must never sit on the
# command line, where every local user can read them from `ps`.
EnvironmentFile=-/etc/xunara/xunarad.env

# State and its ownership are managed by systemd; the flags below are the
# deployment's public surface, so edit them here rather than in a shell script.
StateDirectory=xunara
StateDirectoryMode=0700
ExecStart=/opt/xunara/bin/xunarad \
    -listen 0.0.0.0:9090 \
    -server-url http://fakeop4.onbed.cn:9090 \
    -state-dir /var/lib/xunara \
    -grpc-listen 0.0.0.0:9091 \
    -console-timezone Asia/Shanghai \
    -log-level info \
    -allow-local-login \
    -passkey=false

Restart=on-failure
RestartSec=2s

# The control plane owns one directory and no other part of the host.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
